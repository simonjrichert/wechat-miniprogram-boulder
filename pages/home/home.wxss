.page {
  padding-right: 32rpx;
  padding-left: 32rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  padding-top: 28rpx;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
}

.orb-a {
  width: 380rpx;
  height: 380rpx;
  top: -80rpx;
  right: -120rpx;
  background: radial-gradient(circle, rgba(255, 43, 214, 0.42), transparent 68%);
}

.orb-b {
  width: 320rpx;
  height: 320rpx;
  left: -100rpx;
  top: 180rpx;
  background: radial-gradient(circle, rgba(61, 255, 242, 0.22), transparent 70%);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.kicker {
  margin-top: 18rpx;
  color: #9a94ae;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.date-badge {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(61, 255, 242, 0.75);
  border-radius: 24rpx;
  box-shadow: 0 0 24rpx rgba(61, 255, 242, 0.22);
  background: rgba(7, 6, 11, 0.35);
}

.date-day {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  color: #f4f0ff;
}

.date-mon {
  margin-top: 4rpx;
  color: #3dfff2;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.title {
  display: block;
  position: relative;
  left: 0;
  right: auto;
  font-size: 84rpx;
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -1rpx;
  color: #f7f4ff;
}

.accent {
  color: #3dfff2;
}

.zh {
  display: block;
  position: relative;
  margin-top: 28rpx;
  color: #c6ff4a;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.when {
  display: block;
  position: relative;
  margin-top: 8rpx;
  color: #b7b1c9;
  font-size: 26rpx;
}

.facts {
  display: flex;
  position: relative;
  margin-top: 36rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.fact {
  flex: 1;
  padding: 22rpx 0;
}

.fact + .fact {
  padding-left: 20rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.fact-k {
  display: block;
  color: #9a94ae;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.fact-v {
  display: block;
  margin-top: 6rpx;
  color: #f4f0ff;
  font-size: 32rpx;
  font-weight: 700;
}

.wall {
  position: relative;
  height: 460rpx;
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  background-color: #100e18;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.16) 1rpx, transparent 2rpx);
  background-size: 48rpx 48rpx;
  box-shadow: inset 0 0 80rpx rgba(0, 0, 0, 0.45);
}

.stamp {
  position: absolute;
  top: 28rpx;
  right: 24rpx;
  z-index: 2;
  padding: 6rpx 12rpx;
  border: 2rpx solid #c6ff4a;
  color: #c6ff4a;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  transform: rotate(8deg);
  animation: glow 2.8s ease-in-out infinite;
}

@keyframes glow {
  0%,
  100% { opacity: 0.72; }
  50% { opacity: 1; }
}

.tape {
  position: absolute;
  height: 3rpx;
  background: rgba(198, 255, 74, 0.7);
  box-shadow: 0 0 10rpx rgba(198, 255, 74, 0.65);
}

.tape-a {
  left: 64rpx;
  top: 318rpx;
  width: 130rpx;
  transform: rotate(-26deg);
}

.tape-b {
  left: 176rpx;
  top: 214rpx;
  width: 150rpx;
  transform: rotate(-34deg);
}

.tape-c {
  left: 300rpx;
  top: 132rpx;
  width: 210rpx;
  transform: rotate(-20deg);
}

.hold {
  position: absolute;
}

.shape-jug {
  border-radius: 46%;
}

.shape-pinch {
  border-radius: 10rpx;
  transform: rotate(28deg);
}

.tone-cyan {
  background: #123f3f;
  border: 2rpx solid #3dfff2;
  box-shadow: 0 0 18rpx rgba(61, 255, 242, 0.9);
}

.tone-magenta {
  background: #3a1030;
  border: 2rpx solid #ff2bd6;
  box-shadow: 0 0 18rpx rgba(255, 43, 214, 0.85);
}

.tone-lime {
  background: #24340c;
  border: 2rpx solid #c6ff4a;
  box-shadow: 0 0 16rpx rgba(198, 255, 74, 0.8);
}

.caption {
  display: block;
  margin-top: 16rpx;
  color: #9a94ae;
  font-size: 24rpx;
}

.section {
  margin-top: 56rpx;
}

.h {
  display: block;
  margin-bottom: 20rpx;
  color: #9a94ae;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.intro {
  display: block;
  margin-top: -6rpx;
  margin-bottom: 20rpx;
  color: #d8d3e8;
  font-size: 26rpx;
}

.slot {
  display: flex;
  margin-bottom: 22rpx;
}

.slot-t {
  width: 96rpx;
  flex-shrink: 0;
  color: #3dfff2;
  font-size: 26rpx;
  font-weight: 700;
}

.slot-d {
  flex: 1;
  color: #d8d3e8;
  font-size: 26rpx;
  line-height: 1.45;
}

.wave {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #12101a;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.wave.mine {
  border-color: rgba(61, 255, 242, 0.85);
  box-shadow: 0 0 28rpx rgba(61, 255, 242, 0.12);
}

.wave-hover {
  opacity: 0.82;
}

.wave-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wave-name {
  font-size: 30rpx;
  font-weight: 700;
}

.wave-go {
  color: #3dfff2;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.wave-time {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #f4f0ff;
}

.wave-note {
  display: block;
  margin-top: 6rpx;
  color: #9a94ae;
  font-size: 24rpx;
}

.price-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-bottom: 22rpx;
}

.big {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  color: #f4f0ff;
}

.per {
  flex: 1 0 100%;
  margin-top: 10rpx;
  color: #9a94ae;
  font-size: 26rpx;
  line-height: 1.4;
}

.inc,
.rule {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.pip {
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #c6ff4a;
  box-shadow: 0 0 10rpx #c6ff4a;
}

.dash {
  width: 18rpx;
  height: 3rpx;
  margin-top: 18rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #ff2bd6;
}

.inc-t,
.rule-t {
  flex: 1;
  color: #efeaff;
  font-size: 28rpx;
  line-height: 1.45;
}

.place {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #12101a;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.place-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.place-line {
  display: block;
  margin-top: 8rpx;
  color: #efeaff;
  font-size: 28rpx;
}

.place-dim {
  display: block;
  margin-top: 8rpx;
  color: #9a94ae;
  font-size: 24rpx;
}

.place-note {
  display: block;
  margin-top: 18rpx;
  color: #d8d3e8;
  font-size: 26rpx;
  line-height: 1.45;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(7, 6, 11, 0.96);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.dock-copy {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.dock-code {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.dock-sub {
  display: block;
  margin-top: 2rpx;
  color: #9a94ae;
  font-size: 22rpx;
}
