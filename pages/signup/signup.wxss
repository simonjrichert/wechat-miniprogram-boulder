.page {
  padding-right: 32rpx;
  padding-left: 32rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.kicker {
  display: block;
  margin-top: 28rpx;
  color: #9a94ae;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.lead {
  display: block;
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.sub,
.keep {
  display: block;
  margin-top: 8rpx;
  color: #b7b1c9;
  font-size: 26rpx;
}

.keep {
  color: #c6ff4a;
}

.block {
  margin-top: 40rpx;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #9a94ae;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.choice {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #12101a;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.choice.on {
  border-color: rgba(61, 255, 242, 0.85);
  box-shadow: 0 0 28rpx rgba(61, 255, 242, 0.12);
}

.choice-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.choice-meta {
  display: block;
  margin-top: 6rpx;
  color: #9a94ae;
  font-size: 24rpx;
  line-height: 1.4;
}

.ph {
  color: #6e6884;
}

.field {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #14121c;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #f4f0ff;
  font-size: 30rpx;
}

.picker {
  margin-top: 4rpx;
  line-height: 96rpx;
}

.agree {
  display: flex;
  align-items: flex-start;
  margin-top: 36rpx;
}

.tick {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  border: 2rpx solid rgba(198, 255, 74, 0.75);
}

.tick.on {
  background: #c6ff4a;
  border-color: #c6ff4a;
}

.tick-mark {
  width: 16rpx;
  height: 8rpx;
  margin-top: -6rpx;
  border-left: 4rpx solid #152006;
  border-bottom: 4rpx solid #152006;
  transform: rotate(-45deg);
}

.agree-copy {
  flex: 1;
  color: #efeaff;
  font-size: 26rpx;
  line-height: 1.45;
}

.error {
  display: block;
  margin-top: 28rpx;
  color: #ff8ac4;
  font-size: 26rpx;
}

.submit {
  width: 100%;
  margin-top: 28rpx;
}

.fine {
  display: block;
  margin-top: 16rpx;
  color: #6e6884;
  font-size: 22rpx;
  line-height: 1.45;
}
