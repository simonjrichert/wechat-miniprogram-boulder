.page {
  padding-right: 32rpx;
  padding-left: 32rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.saved {
  display: block;
  margin-top: 28rpx;
  color: #c6ff4a;
  font-size: 26rpx;
}

.pass {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 32rpx;
  border: 1rpx solid rgba(61, 255, 242, 0.35);
  background: linear-gradient(180deg, #16131f 0%, #0c0b12 100%);
}

.pass-bar {
  height: 8rpx;
  background: linear-gradient(90deg, #3dfff2, #c6ff4a 42%, #ff2bd6);
}

.pass-body {
  padding: 32rpx 32rpx 36rpx;
}

.series {
  display: block;
  color: #9a94ae;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.night {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: #f4f0ff;
}

.zh {
  display: block;
  margin-top: 12rpx;
  color: #c6ff4a;
  font-size: 26rpx;
}

.code-wrap {
  margin-top: 32rpx;
  margin-bottom: 12rpx;
  padding: 28rpx 8rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.16);
  border-bottom: 1rpx dashed rgba(255, 255, 255, 0.16);
}

.code {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #3dfff2;
  text-shadow: 0 0 18rpx rgba(61, 255, 242, 0.45);
}

.code-hint {
  display: block;
  margin-top: 8rpx;
  color: #6e6884;
  font-size: 22rpx;
}

.row {
  display: flex;
  margin-top: 22rpx;
}

.k {
  width: 120rpx;
  flex-shrink: 0;
  color: #9a94ae;
  font-size: 24rpx;
}

.v {
  flex: 1;
  color: #f4f0ff;
  font-size: 28rpx;
}

.phone-hint {
  display: block;
  margin-top: 8rpx;
  margin-left: 120rpx;
  color: #6e6884;
  font-size: 22rpx;
}

.where {
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
}

.where-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.where-line,
.where-door {
  display: block;
  margin-top: 6rpx;
  color: #d8d3e8;
  font-size: 26rpx;
}

.where-door {
  margin-top: 14rpx;
  color: #3dfff2;
}

.fine {
  display: block;
  margin-top: 20rpx;
  color: #6e6884;
  font-size: 22rpx;
  line-height: 1.45;
}

.wide {
  width: 100%;
  margin-top: 28rpx;
}

.text-btn {
  width: 100%;
  height: 80rpx;
  margin-top: 8rpx;
  line-height: 80rpx;
  text-align: center;
  color: #ff8ac4;
  font-size: 26rpx;
}

.lead {
  display: block;
  margin-top: 36rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 12rpx;
  color: #b7b1c9;
  font-size: 28rpx;
}

.empty-btn {
  margin-top: 36rpx;
}
