.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: #07060b;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.bar {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  position: relative;
}

.side {
  display: flex;
  align-items: center;
  min-width: 140rpx;
}

.brand {
  display: flex;
  align-items: center;
}

.word {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #f4f0ff;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #3dfff2;
  box-shadow: 0 0 12rpx #3dfff2;
}

.back {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding-right: 16rpx;
  color: #f4f0ff;
  font-size: 28rpx;
}

.back-hover {
  opacity: 0.6;
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  border-left: 4rpx solid #f4f0ff;
  border-bottom: 4rpx solid #f4f0ff;
  transform: rotate(45deg);
}

.nav-title {
  position: absolute;
  left: 180rpx;
  right: 180rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #f4f0ff;
}
